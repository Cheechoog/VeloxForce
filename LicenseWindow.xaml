<Controls:MetroWindow x:Class="FortniteBoost.LicenseWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    Title="Activacion"
    Width="560" SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    GlowBrush="{StaticResource NeonBlueBrush}"
    BorderThickness="1">

    <Border Background="{StaticResource DarkBackgroundBrush}" Padding="32,28">
        <StackPanel>

            <!-- Titulo -->
            <TextBlock x:Name="TitleText"
                       Text="Activar VeloxForge"
                       FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="StatusText"
                       Margin="0,6,0,22"
                       FontFamily="Segoe UI" FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"/>

            <!-- Paso 1: codigo del equipo -->
            <TextBlock Text="1. Envia este codigo de equipo por WhatsApp"
                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource NeonBlueBrush}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RequestCodeBox"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                             Foreground="{StaticResource NeonGreenBrush}"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="COPIAR"
                            Style="{StaticResource OutlineButton}"
                            Click="CopyRequest_Click"/>
                </Grid>
            </Border>
            <Button Content="ENVIAR POR WHATSAPP"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,10,0,24"
                    Click="WhatsApp_Click"/>

            <!-- Paso 2: codigo de activacion -->
            <TextBlock Text="2. Pega aqui el codigo de activacion que te enviaron"
                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource NeonBlueBrush}" Margin="0,0,0,8"/>
            <TextBox x:Name="ActivationBox"
                     Height="90"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Controls:TextBoxHelper.Watermark="XXXXX-XXXXX-XXXXX-..."/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="SALIR"
                        Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Stretch"
                        Click="Exit_Click"/>
                <Button Grid.Column="2" Content="ACTIVAR"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="Activate_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Controls:MetroWindow>
