<Controls:MetroWindow x:Class="FortniteBoost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    Title="VeloxForge"
    Height="680" Width="1120"
    MinHeight="620" MinWidth="960"
    WindowStartupLocation="CenterScreen"
    GlowBrush="{StaticResource NeonBlueBrush}"
    BorderThickness="1"
    ResizeMode="CanResize">

    <Controls:MetroWindow.Resources>
        <LinearGradientBrush x:Key="TopAccentLine" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00F5FF" Offset="0"/>
            <GradientStop Color="#0066CC" Offset="0.5"/>
            <GradientStop Color="#00FF88" Offset="1"/>
        </LinearGradientBrush>
    </Controls:MetroWindow.Resources>

    <Grid Background="{StaticResource DarkBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarGradient}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,20"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36"
                                    Background="{StaticResource AccentButtonGradient}"
                                    CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="VF" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                           Foreground="#070B0F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="VELOX" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource NeonBlueBrush}"/>
                                <TextBlock Text="FORGE" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource NeonGreenBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource StatusBadge}" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="LicenseBadge" Text="LICENCIA ACTIVA"
                                       FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource NeonGreenBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Navegacion -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <TextBlock Text="// NAVEGACION" Style="{StaticResource SectionLabel}"/>
                    <Button x:Name="NavDashboard" Content="  DASHBOARD"      Tag="dashboard" Click="Nav_Click"/>
                    <Button x:Name="NavPerfiles"  Content="  PERFILES GAMER" Tag="perfiles"  Click="Nav_Click"/>
                    <Button x:Name="NavFps"       Content="  MOSTRAR FPS"    Tag="fps"       Click="Nav_Click"/>
                    <Button x:Name="NavHardware"  Content="  HARDWARE"       Tag="hardware"  Click="Nav_Click"/>
                    <Button x:Name="NavBackups"   Content="  BACKUPS"        Tag="backups"   Click="Nav_Click"/>
                </StackPanel>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="20,14"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Admin Mode Activo" FontFamily="Consolas" FontSize="9"
                                   Foreground="{StaticResource NeonGreenBrush}"/>
                        <TextBlock x:Name="LicenseFooter" Text="" FontFamily="Consolas" FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ══════════════ PANEL PRINCIPAL ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="0" Fill="{StaticResource TopAccentLine}"/>

            <!-- Header / breadcrumb -->
            <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="VELOXFORGE" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="CrumbText" Text=" / Dashboard" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource NeonGreenBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="SISTEMA LISTO" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource NeonGreenBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Aqui se cargan las paginas -->
            <ContentControl x:Name="PageHost" Grid.Row="2"/>
        </Grid>
    </Grid>
</Controls:MetroWindow>
