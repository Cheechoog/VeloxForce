<UserControl x:Class="FortniteBoost.Pages.HardwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

            <TextBlock Text="Hardware del equipo" Style="{StaticResource NeonTitle}"
                       FontSize="20" Margin="0,0,0,18"/>

            <Border Style="{StaticResource GamerCard}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="PROCESADOR (CPU)" FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="CpuText" Text="Detectando..." FontFamily="Segoe UI" FontSize="15"
                               Foreground="{StaticResource NeonBlueBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GamerCard}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="TARJETA GRAFICA (GPU)" FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="GpuText" Text="Detectando..." FontFamily="Segoe UI" FontSize="15"
                               Foreground="{StaticResource NeonPurpleBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GamerCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MEMORIA (RAM)" FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="RamText" Text="Detectando..." FontFamily="Segoe UI" FontSize="15"
                               Foreground="{StaticResource NeonGreenBrush}"/>
                </StackPanel>
            </Border>

            <Button Content="ACTUALIZAR" Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Left" Click="Refresh_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
