<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ COLORES BASE ═══════════════════════════════════════════════════ -->
    <Color x:Key="NeonCyanColor"     >#00F5FF</Color>
    <Color x:Key="NeonGreenColor"    >#00FF88</Color>
    <Color x:Key="NeonRedColor"      >#FF2D55</Color>
    <Color x:Key="NeonPurpleColor"   >#BF5FFF</Color>
    <Color x:Key="BgDeepColor"       >#070B0F</Color>
    <Color x:Key="BgCardColor"       >#0D1117</Color>
    <Color x:Key="BgSurfaceColor"    >#131920</Color>
    <Color x:Key="BorderSubtleColor" >#1E2D3D</Color>
    <Color x:Key="TextPrimaryColor"  >#E6EDF3</Color>
    <Color x:Key="TextMutedColor"    >#6B7D8F</Color>

    <!-- ═══ BRUSHES SOLIDOS ════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="NeonBlueBrush"       Color="{StaticResource NeonCyanColor}"/>
    <SolidColorBrush x:Key="NeonGreenBrush"      Color="{StaticResource NeonGreenColor}"/>
    <SolidColorBrush x:Key="NeonRedBrush"        Color="{StaticResource NeonRedColor}"/>
    <SolidColorBrush x:Key="NeonPurpleBrush"     Color="{StaticResource NeonPurpleColor}"/>
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="CardBrush"           Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource TextMutedColor}"/>

    <!-- ═══ BRUSHES GRADIENTE ══════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="NeonCyanGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00F5FF" Offset="0"/>
        <GradientStop Color="#0080FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeonGreenGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FF88" Offset="0"/>
        <GradientStop Color="#00C4A0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D1117" Offset="0"/>
        <GradientStop Color="#070B0F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#070B0F" Offset="0"/>
        <GradientStop Color="#0D1520" Offset="0.5"/>
        <GradientStop Color="#070B0F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentButtonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00C8E0" Offset="0"/>
        <GradientStop Color="#0066CC" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══ GLOW EFFECTS (semi-transparentes) ══════════════════════════════ -->
    <SolidColorBrush x:Key="GlowCyan"   Color="#1A00F5FF"/>
    <SolidColorBrush x:Key="GlowGreen"  Color="#1A00FF88"/>
    <SolidColorBrush x:Key="GlowRed"    Color="#1AFF2D55"/>

</ResourceDictionary>
