<Controls:MetroWindow x:Class="FortniteBoost.BackupWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="Gestión de Backups"
                      Height="400" Width="600"
                      WindowStartupLocation="CenterScreen"
                      GlowBrush="{DynamicResource AccentColorBrush}">

	<Grid Background="{StaticResource DarkBackgroundBrush}">
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">

			<TextBlock Text="💾 Gestión de Backups"
                       Foreground="{StaticResource NeonBlueBrush}"
                       FontSize="20"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

			<!-- Crear Backup -->
			<Button Content="📂 Crear Backup"
                    Click="CreateBackup_Click"
                    Style="{StaticResource GamerButton}"
                    Margin="0,10,0,10"/>

			<!-- Restaurar Backup -->
			<Button Content="🔄 Restaurar Backup"
                    Click="RestoreBackup_Click"
                    Style="{StaticResource GamerButton}"
                    Margin="0,10,0,10"/>

			<!-- Log -->
			<ListBox x:Name="BackupLog"
                     Width="500" Height="200"
                     Foreground="{StaticResource NeonRedBrush}"
                     Background="#222"
                     Margin="0,20,0,0"/>
		</StackPanel>
	</Grid>
</Controls:MetroWindow>
